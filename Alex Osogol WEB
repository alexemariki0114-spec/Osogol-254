<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alex's Portfolio</title>
<style>
  /* ----- Reset & Global ----- */
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: Arial, sans-serif; line-height: 1.6; background-color: #f0f4f8; color: #333; }

  a { text-decoration: none; color: inherit; }

  /* ----- Navigation ----- */
  nav {
    background-color: #2c3e50;
    color: white;
    padding: 15px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }
  nav h2 { font-size: 24px; }
  nav ul { list-style: none; display: flex; gap: 20px; }
  nav ul li a { color: white; transition: 0.3s; font-weight: bold; }
  nav ul li a:hover { color: #3498db; }

  /* ----- Hero Section ----- */
  header.hero {
    text-align: center;
    padding: 100px 20px;
    background: url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1500&q=80') center/cover no-repeat;
    color: white;
  }
  header.hero h1 { font-size: 48px; margin-bottom: 20px; text-shadow: 2px 2px 5px rgba(0,0,0,0.5); }
  header.hero p { font-size: 20px; margin-bottom: 30px; text-shadow: 1px 1px 3px rgba(0,0,0,0.5); }
  header.hero button {
    padding: 15px 30px;
    font-size: 18px;
    border: none;
    border-radius: 5px;
    background-color: #3498db;
    color: white;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  header.hero button:hover { background-color: #2980b9; }

  /* ----- Sections ----- */
  section { padding: 80px 20px; max-width: 1000px; margin: auto; }
  section h2 { text-align: center; margin-bottom: 40px; font-size: 36px; color: #2c3e50; }

  .about, .projects, .contact { background-color: white; border-radius: 10px; padding: 40px; box-shadow: 0 0 15px rgba(0,0,0,0.1); margin-bottom: 50px; }

  .about p, .projects p, .contact p { font-size: 18px; margin-bottom: 20px; }

  /* ----- Projects Grid ----- */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }
  .project-card {
    background-color: #f0f4f8;
    padding: 20px;
    border-radius: 10px;
    text-align: center;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  }
  .project-card img {
    width: 100%;
    border-radius: 10px;
    margin-bottom: 15px;
  }

  /* ----- Contact Form ----- */
  .contact form {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .contact input, .contact textarea {
    padding: 12px;
    font-size: 16px;
    border-radius: 5px;
    border: 1px solid #ccc;
  }
  .contact button {
    padding: 15px;
    font-size: 18px;
    border: none;
    border-radius: 5px;
    background-color: #3498db;
    color: white;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .contact button:hover { background-color: #2980b9; }

  /* ----- Footer ----- */
  footer {
    text-align: center;
    padding: 30px 20px;
    background-color: #2c3e50;
    color: white;
  }

  /* ----- Responsive ----- */
  @media(max-width:600px){
    nav ul { flex-direction: column; gap:10px; }
    header.hero h1 { font-size:36px; }
  }
</style>
</head>
<body>

<!-- Navigation -->
<nav>
  <h2>Alex</h2>
  <ul>
    <li><a href="#about">About</a></li>
    <li><a href="#projects">Projects</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
</nav>

<!-- Hero Section -->
<header class="hero">
  <h1>Welcome to My Portfolio</h1>
  <p>Building systems, managing projects, and learning every day.</p>
  <button onclick="sayHello()">Click Me!</button>
</header>

<!-- About Section -->
<section class="about" id="about">
  <h2>About Me</h2>
  <p>Hi! I’m Alex. I specialize in project management, systems engineering, and web development. This website showcases my skills and projects.</p>
</section>

<!-- Projects Section -->
<section class="projects" id="projects">
  <h2>Projects</h2>
  <div class="projects-grid">
    <div class="project-card">
      <img src="https://images.unsplash.com/photo-1581090700227-9c69ee609f30?auto=format&fit=crop&w=600&q=80" alt="Project 1">
      <h3>Project 1</h3>
      <p>Generator Management System Dashboard.</p>
    </div>
    <div class="project-card">
      <img src="https://images.unsplash.com/photo-1605902711622-cfb43c4438f8?auto=format&fit=crop&w=600&q=80" alt="Project 2">
      <h3>Project 2</h3>
      <p>Inventory & Stock Tracking App.</p>
    </div>
    <div class="project-card">
      <img src="https://images.unsplash.com/photo-1559028012-4819c9f2eb07?auto=format&fit=crop&w=600&q=80" alt="Project 3">
      <h3>Project 3</h3>
      <p>Website & System Automation Tools.</p>
    </div>
  </div>
</section>

<!-- Contact Section -->
<section class="contact" id="contact">
  <h2>Contact Me</h2>
  <p>Send me a message and I will get back to you!</p>
  <form onsubmit="handleSubmit(event)">
    <input type="text" placeholder="Your Name" required>
    <input type="email" placeholder="Your Email" required>
    <textarea placeholder="Your Message" rows="5" required></textarea>
    <button type="submit">Send Message</button>
  </form>
</section>

<!-- Footer -->
<footer>
  <p>© 2026 Alex. All rights reserved.</p>
</footer>

<script>
function sayHello() {
  alert("Hello! Welcome to my website. 🎉");
}
function handleSubmit(event) {
  event.preventDefault();
  alert("Thank you for your message! I will get back to you soon.");
  event.target.reset();
}
</script>

</body>
</html>
